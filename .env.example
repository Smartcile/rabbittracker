# Copy to .env for `docker compose up -d --build` (Docker Compose and Portainer
# Git stacks). All values are optional — the defaults below are what the app
# uses when the variable is unset.
#
# Deploying the prebuilt image in Portainer's web editor instead? Use
# compose.portainer.yaml, which has these values inline and needs no .env.

# Host port the app is published on.
APP_PORT=8091

# Host port for the bundled Postgres (local development / external tools only).
# If you change it, update DATABASE_URL to match.
DB_PORT=5434

# Database credentials for the bundled Postgres container. Change the password
# before exposing the stack to a network you do not control.
POSTGRES_USER=rabbittracker
POSTGRES_PASSWORD=rabbittracker
POSTGRES_DB=rabbittracker

# Set to true only when the app is served over HTTPS (otherwise login breaks).
COOKIE_SECURE=false

# Sessions: idle lock / server-side idle expiry, and absolute lifetime.
SESSION_IDLE_MINUTES=30
SESSION_TTL_MINUTES=10080

# Where uploaded photos are stored inside the app container.
DATA_DIR=/data
